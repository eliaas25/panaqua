# Variables de Entorno para Panaqua
# Copiá este archivo como .env y completá con tus datos reales.

# WhatsApp (formato internacional sin +, ej: 5493411234567)
VITE_WHATSAPP_NUMBER=549XXXXXXXXXX

# Email de contacto
VITE_CONTACT_EMAIL=tu@email.com

# Instagram
VITE_INSTAGRAM_URL=https://www.instagram.com/tu-usuario


# Supabase (Project Settings -> API)
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon...
